#!/usr/bin/env bash

#===============================================================================
#  ZeroTrustKit - DevSecOps Bootstrap Platform
#  Author: Daxxtropezz  
#  Version: 1.2.0
#===============================================================================

SCRIPT_NAME="ztk"
SCRIPT_VERSION="1.2.0"
APP_NAME="ZeroTrustKit"
APP_AUTHOR="Daxxtropezz"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
Lavender='\033[0;34m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# Queue
declare -a INSTALL_QUEUE=()

# Tool definitions
declare -A TOOLS
TOOLS[1]="base_packages"
TOOLS[2]="git"
TOOLS[3]="terraform"
TOOLS[4]="aws_cli"
TOOLS[5]="docker"
TOOLS[6]="docker_compose"
TOOLS[7]="lazydocker"
TOOLS[8]="ansible"
TOOLS[9]="snyk"
TOOLS[10]="trivy"
TOOLS[11]="gcp"
TOOLS[12]="kubernetes"
TOOLS[13]="helm"
TOOLS[14]="minikube"
TOOLS[15]="nmap"
TOOLS[16]="python"
TOOLS[17]="azure_cli"

# Tool display names
declare -A TOOL_DISPLAY
TOOL_DISPLAY[base_packages]="Base Packages (curl, wget, git, unzip, build-essential, etc)"
TOOL_DISPLAY[git]="Git - Version Control"
TOOL_DISPLAY[terraform]="Terraform - Infrastructure as Code"
TOOL_DISPLAY[aws_cli]="AWS CLI - Amazon Web Services"
TOOL_DISPLAY[docker]="Docker - Container Platform"
TOOL_DISPLAY[docker_compose]="Docker Compose - Multi-container Applications"
TOOL_DISPLAY[lazydocker]="Lazydocker - Docker TUI"
TOOL_DISPLAY[ansible]="Ansible - Automation & Configuration Management"
TOOL_DISPLAY[snyk]="Snyk - Vulnerability Scanning"
TOOL_DISPLAY[trivy]="Trivy - Security Scanner"
TOOL_DISPLAY[gcp]="Google Cloud SDK - GCP Tools"
TOOL_DISPLAY[kubernetes]="Kubernetes Tools (kubectl)"
TOOL_DISPLAY[helm]="Helm - Kubernetes Package Manager"
TOOL_DISPLAY[minikube]="Minikube - Local Kubernetes Cluster"
TOOL_DISPLAY[nmap]="Nmap - Network Discovery"
TOOL_DISPLAY[python]="Python 3 + pip + virtualenv"
TOOL_DISPLAY[azure_cli]="Azure CLI - Microsoft Azure"

#===============================================================================
# PLATFORM DETECTION
#===============================================================================

OS="$(uname -s)"
ARCH="$(uname -m)"

case "$OS" in
    Linux)
        PLATFORM="linux"
        PACKAGE_MANAGER="apt"
        ;;
    Darwin)
        PLATFORM="macos"
        PACKAGE_MANAGER="brew"
        ;;
    *)
        echo "❌ Unsupported operating system: $OS"
        exit 1
        ;;
esac

#===============================================================================
# ARCHITECTURE DETECTION
#===============================================================================

case "$ARCH" in
    x86_64|amd64)
        LINUX_ARCH="amd64"
        AWS_ARCH="x86_64"
        LAZYDOCKER_ARCH="x86_64"
        SNYK_ARCH=""
        ;;
    arm64|aarch64)
        LINUX_ARCH="arm64"
        AWS_ARCH="aarch64"
        LAZYDOCKER_ARCH="arm64"
        SNYK_ARCH="-arm64"
        ;;
    *)
        echo "❌ Unsupported architecture: $ARCH"
        exit 1
        ;;
esac

#===============================================================================
# PACKAGE MANAGER HELPERS
#===============================================================================

ensure_homebrew() {
    if [[ "$PLATFORM" == "macos" ]]; then
        if ! command -v brew >/dev/null 2>&1; then
            echo -e "${YELLOW}→ Installing Homebrew...${RESET}"
            /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

            # Apple Silicon support
            if [[ -x "/opt/homebrew/bin/brew" ]]; then
                eval "$(/opt/homebrew/bin/brew shellenv)"
            elif [[ -x "/usr/local/bin/brew" ]]; then
                eval "$(/usr/local/bin/brew shellenv)"
            fi
        fi
    fi
}

pkg_install() {
    if [[ "$PACKAGE_MANAGER" == "brew" ]]; then
        ensure_homebrew
        brew install "$@"
    else
        sudo apt install -y "$@"
    fi
}

pkg_update() {
    if [[ "$PACKAGE_MANAGER" == "brew" ]]; then
        brew update
    else
        sudo apt update -qq
    fi
}

pkg_upgrade() {
    if [[ "$PACKAGE_MANAGER" == "brew" ]]; then
        brew upgrade "$@" || brew install "$@"
    else
        sudo apt upgrade -y "$@"
    fi
}

#===============================================================================
#  UTILITY FUNCTIONS
#===============================================================================

clear_screen() {
    printf "\033[2J\033[1;1H\033[3J"
    clear 2>/dev/null || printf "\033c"
}

tool_installed() {
    case "$1" in
        base_packages) return 1 ;; # Always install/update base packages
        git) command -v git >/dev/null 2>&1 ;;
        terraform) command -v terraform >/dev/null 2>&1 ;;
        aws_cli) command -v aws >/dev/null 2>&1 ;;
        docker) command -v docker >/dev/null 2>&1 ;;
        docker_compose) command -v docker-compose >/dev/null 2>&1 || docker compose version >/dev/null 2>&1 ;;
        lazydocker) command -v lazydocker >/dev/null 2>&1 ;;
        ansible) command -v ansible >/dev/null 2>&1 ;;
        snyk) command -v snyk >/dev/null 2>&1 ;;
        trivy) command -v trivy >/dev/null 2>&1 ;;
        gcp) command -v gcloud >/dev/null 2>&1 ;;
        kubernetes) command -v kubectl >/dev/null 2>&1 ;;
        helm) command -v helm >/dev/null 2>&1 ;;
        minikube) command -v minikube >/dev/null 2>&1 ;;
        nmap) command -v nmap >/dev/null 2>&1 ;;
        python) command -v python3 >/dev/null 2>&1 ;;
        azure_cli) command -v az >/dev/null 2>&1 ;;
        *) return 1 ;;
    esac
}

update_if_installed() {
    local tool="$1"
    if [ "$tool" != "base_packages" ] && tool_installed "$tool"; then
        echo -e "${YELLOW}→ Updating ${TOOL_DISPLAY[$tool]} to latest version...${RESET}"
        return 0
    fi
    return 1
}

brew_cask_install_or_upgrade() {
    local package="$1"

    ensure_homebrew

    if brew list --cask "$package" >/dev/null 2>&1; then
        echo -e "${YELLOW}→ Updating $package...${RESET}"
        brew upgrade --cask "$package" || true
    else
        echo -e "${CYAN}→ Installing $package...${RESET}"
        brew install --cask "$package"
    fi
}

brew_install_or_upgrade() {
    local package="$1"

    ensure_homebrew

    if brew list --formula "$package" >/dev/null 2>&1; then
        echo -e "${YELLOW}→ Updating $package...${RESET}"
        brew upgrade "$package" || true
    else
        echo -e "${CYAN}→ Installing $package...${RESET}"
        brew install "$package"
    fi
}

#===============================================================================
#  INSTALLATION FUNCTIONS
#===============================================================================

install_base_packages() {
    echo -e "${CYAN}→ Installing base packages...${RESET}"

    pkg_update

    if [[ "$PLATFORM" == "macos" ]]; then
        pkg_install curl wget git jq tree htop tmux zsh unzip
    else
        pkg_install \
            curl wget git unzip gnupg2 software-properties-common \
            build-essential apt-transport-https ca-certificates \
            jq tree htop tmux zsh
    fi

    echo -e "${GREEN}✓ Base packages installed${RESET}"
}

install_git() {
    echo -e "${CYAN}→ Installing/Updating Git...${RESET}"

    pkg_update
    pkg_upgrade git

    echo -e "${GREEN}✓ Git ready${RESET}"
}

install_terraform() {
    echo -e "${CYAN}→ Installing/Updating Terraform...${RESET}"

    if [[ "$PLATFORM" == "macos" ]]; then
        brew tap hashicorp/tap

        if brew list --formula hashicorp/tap/terraform >/dev/null 2>&1; then
            brew upgrade hashicorp/tap/terraform || true
        else
            brew install hashicorp/tap/terraform
        fi
    else
        wget -qO- https://apt.releases.hashicorp.com/gpg \
            | sudo gpg --dearmor \
            -o /usr/share/keyrings/hashicorp-archive-keyring.gpg

        echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" \
            | sudo tee /etc/apt/sources.list.d/hashicorp.list >/dev/null

        pkg_update

        if tool_installed terraform; then
            sudo apt install --only-upgrade -y terraform
        else
            sudo apt install -y terraform
        fi
    fi

    echo -e "${GREEN}✓ Terraform ready${RESET}"
}

install_aws_cli() {

    echo -e "${CYAN}→ Installing AWS CLI...${RESET}"

    if [[ "$PLATFORM" == "macos" ]]; then
        brew_install_or_upgrade awscli
    else
        curl -s https://awscli.amazonaws.com/awscli-exe-linux-${AWS_ARCH}.zip \
            -o /tmp/awscliv2.zip

        unzip -q /tmp/awscliv2.zip -d /tmp
        sudo /tmp/aws/install --update
        rm -rf /tmp/aws /tmp/awscliv2.zip
    fi

    echo -e "${GREEN}✓ AWS CLI installed${RESET}"
}

install_docker() {

    echo -e "${CYAN}→ Installing/Updating Docker...${RESET}"

    if [[ "$PLATFORM" == "macos" ]]; then
        brew_cask_install_or_upgrade docker-desktop
    else
        if tool_installed docker; then
            pkg_update
            sudo apt install --only-upgrade -y docker-ce
        else
            curl -fsSL https://get.docker.com | sudo sh
            sudo usermod -aG docker "$USER"
        fi
    fi

    echo -e "${GREEN}✓ Docker ready${RESET}"
}

install_docker_compose() {

    echo -e "${CYAN}→ Installing Docker Compose...${RESET}"

    if [[ "$PLATFORM" == "macos" ]]; then
        brew_install_or_upgrade  docker-compose
    else
        sudo curl -sL \
        "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" \
        -o /usr/local/bin/docker-compose

        sudo chmod +x /usr/local/bin/docker-compose
    fi

    echo -e "${GREEN}✓ Docker Compose installed${RESET}"
}

install_lazydocker() {
    echo -e "${CYAN}→ Installing/Updating Lazydocker...${RESET}"

    if [[ "$PLATFORM" == "macos" ]]; then
        brew_install_or_upgrade lazydocker
    else
        # Upstream installer handles amd64/arm64 architecture mapping.
        curl -fsSL https://raw.githubusercontent.com/jesseduffield/lazydocker/master/scripts/install_update_linux.sh \
            | DIR=/usr/local/bin sudo -E bash
    fi

    echo -e "${GREEN}✓ Lazydocker ready${RESET}"
}

install_ansible() {

    echo -e "${CYAN}→ Installing Ansible...${RESET}"

    if [[ "$PLATFORM" == "macos" ]]; then
        brew_install_or_upgrade  ansible
    else
        sudo apt-add-repository --yes --update ppa:ansible/ansible
        pkg_install ansible
    fi

    echo -e "${GREEN}✓ Ansible installed${RESET}"
}

install_snyk() {
    echo -e "${CYAN}→ Installing/Updating Snyk...${RESET}"

    if [[ "$PLATFORM" == "macos" ]]; then
        brew_install_or_upgrade snyk-cli
    else
        local snyk_url="https://downloads.snyk.io/cli/stable/snyk-linux${SNYK_ARCH}"
        curl --compressed -fsSL "$snyk_url" -o /tmp/snyk
        sudo install -m 0755 /tmp/snyk /usr/local/bin/snyk
        rm -f /tmp/snyk
    fi

    echo -e "${GREEN}✓ Snyk ready${RESET}"
}

install_trivy() {
    echo -e "${CYAN}→ Installing/Updating Trivy...${RESET}"

    if [[ "$PLATFORM" == "macos" ]]; then
        brew_install_or_upgrade trivy
    else
        if update_if_installed trivy; then
            pkg_update && sudo apt upgrade -y trivy
            echo -e "${GREEN}✓ Trivy updated to latest version${RESET}"
            return 0
        fi
        sudo apt install -y wget gnupg
        wget -qO- https://aquasecurity.github.io/trivy-repo/deb/public.key | sudo gpg --dearmor -o /usr/share/keyrings/trivy.gpg
        echo "deb [signed-by=/usr/share/keyrings/trivy.gpg] https://aquasecurity.github.io/trivy-repo/deb $(lsb_release -sc) main" | sudo tee /etc/apt/sources.list.d/trivy.list
        pkg_update
        sudo apt install -y trivy
    fi

    echo -e "${GREEN}✓ Trivy ready${RESET}"
}

install_gcp() {

    echo -e "${CYAN}→ Installing Google Cloud SDK...${RESET}"

    if [[ "$PLATFORM" == "macos" ]]; then
        brew_cask_install_or_upgrade gcloud-cli
    else
        if update_if_installed gcp; then
            pkg_update && sudo apt install --only-upgrade -y google-cloud-cli
            echo -e "${GREEN}✓ Google Cloud SDK updated to latest version${RESET}"
            return 0
        fi
        sudo rm -f /etc/apt/sources.list.d/google-cloud-sdk.list
        echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" | sudo tee /etc/apt/sources.list.d/google-cloud-sdk.list
        curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | sudo gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg
        pkg_update
        sudo apt install -y google-cloud-cli
    fi

    echo -e "${GREEN}✓ Google Cloud SDK installed${RESET}"
}

install_azure_cli() {
    echo -e "${CYAN}→ Installing/Updating Azure CLI...${RESET}"

    if [[ "$PLATFORM" == "macos" ]]; then
        brew_install_or_upgrade azure-cli
    else
        local distro_id=""
        local distro_codename=""

        if [[ -r /etc/os-release ]]; then
            # shellcheck disable=SC1091
            . /etc/os-release
            distro_id="${ID:-}"
            distro_codename="${VERSION_CODENAME:-${UBUNTU_CODENAME:-}}"
        fi

        if [[ "$distro_id" == "ubuntu" && "$distro_codename" != "jammy" && "$distro_codename" != "noble" ]]; then
            echo -e "${YELLOW}⚠ Microsoft currently documents Azure CLI APT packages as tested on Ubuntu 22.04 (jammy) and 24.04 (noble).${RESET}"
            echo -e "${YELLOW}  Detected Ubuntu codename: ${distro_codename:-unknown}. Installation will still be attempted using Microsoft's installer.${RESET}"
        fi

        if tool_installed azure_cli; then
            pkg_update
            sudo apt install --only-upgrade -y azure-cli
        else
            curl -sL https://aka.ms/InstallAzureCLIDeb | sudo bash
        fi
    fi

    echo -e "${GREEN}✓ Azure CLI ready${RESET}"
}

install_kubernetes() {

    echo -e "${CYAN}→ Installing Kubectl...${RESET}"

    if [[ "$PLATFORM" == "macos" ]]; then
        brew_install_or_upgrade kubectl
    else
        if update_if_installed kubernetes; then
            curl -sLO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/${LINUX_ARCH}/kubectl"
            sudo install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl
            rm kubectl
            echo -e "${GREEN}✓ Kubectl updated to latest version${RESET}"
            return 0
        fi
        curl -sLO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/${LINUX_ARCH}/kubectl"
        sudo install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl
        rm kubectl
    fi
    echo -e "${GREEN}✓ Kubectl installed${RESET}"
}

install_helm() {

    echo -e "${CYAN}→ Installing Helm...${RESET}"

    if [[ "$PLATFORM" == "macos" ]]; then
        brew_install_or_upgrade helm
    else
        if update_if_installed helm; then
            curl -fsSL -o get_helm.sh https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3
            chmod 700 get_helm.sh
            ./get_helm.sh
            rm get_helm.sh
            echo -e "${GREEN}✓ Helm updated to latest version${RESET}"
            return 0
        fi
        curl -fsSL -o get_helm.sh https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3
        chmod 700 get_helm.sh
        ./get_helm.sh
        rm get_helm.sh
    fi
    echo -e "${GREEN}✓ Helm installed${RESET}"
}

install_minikube() {
    echo -e "${CYAN}→ Installing Minikube...${RESET}"
    
    if [[ "$PLATFORM" == "macos" ]]; then
        brew_install_or_upgrade minikube
    else
        if update_if_installed minikube; then
            curl -LO https://storage.googleapis.com/minikube/releases/latest/minikube-linux-${LINUX_ARCH}
            sudo install minikube-linux-${LINUX_ARCH} /usr/local/bin/minikube
            rm minikube-linux-${LINUX_ARCH}
            echo -e "${GREEN}✓ Minikube updated to latest version${RESET}"
            return 0
        fi
        curl -LO https://storage.googleapis.com/minikube/releases/latest/minikube-linux-${LINUX_ARCH}
        sudo install minikube-linux-${LINUX_ARCH} /usr/local/bin/minikube
        rm minikube-linux-${LINUX_ARCH}
    fi
    echo -e "${GREEN}✓ Minikube installed${RESET}"
}

install_nmap() {
    echo -e "${CYAN}→ Installing/Updating Nmap...${RESET}"

    if [[ "$PLATFORM" == "macos" ]]; then
        brew_install_or_upgrade nmap
    else
        pkg_update

        if tool_installed nmap; then
            sudo apt install --only-upgrade -y nmap
        else
            sudo apt install -y nmap
        fi
    fi

    echo -e "${GREEN}✓ Nmap ready${RESET}"
}

install_python() {
    echo -e "${CYAN}→ Installing Python 3, pip, and virtualenv...${RESET}"
    if [[ "$PLATFORM" == "macos" ]]; then
        brew_install_or_upgrade python
        pip3 install virtualenv
    else
        pkg_install python3 python3-pip python3-venv python3-dev
        pip3 install --upgrade pip virtualenv
    fi
    echo -e "${GREEN}✓ Python 3, pip, and virtualenv installed${RESET}"
}

#===============================================================================
#  DISPLAY FUNCTIONS
#===============================================================================

show_banner() {
    if command -v figlet >/dev/null 2>&1 && command -v lolcat >/dev/null 2>&1; then
        figlet -f slant $APP_NAME 2>/dev/null | lolcat 2>/dev/null
    elif command -v figlet >/dev/null 2>&1; then
        figlet -f slant $APP_NAME 2>/dev/null
    else
        echo -e "${CYAN}"
        echo " Install the figlet, lolcat packages for better visuals! "
        echo -e "${RESET}"
    fi
    echo -e "${BOLD}${WHITE}  ═══════════════════════════════════════════════════════════════════════════════════════${RESET}"
    echo -e "${BOLD}${WHITE}                  DevSecOps Bootstrap Platform v$SCRIPT_VERSION | Author: $APP_AUTHOR${RESET}"
    echo -e "${BOLD}${WHITE}  ═══════════════════════════════════════════════════════════════════════════════════════${RESET}"
}

show_menu() {
    clear_screen
    show_banner
    
    # Show system info
    echo -e "  ${CYAN}System:${RESET} $(uname -n)  |  ${CYAN}User:${RESET} $USER  |  ${CYAN}Date:${RESET} $(date '+%Y-%m-%d %H:%M:%S')"
    
    echo -e "${BOLD}${WHITE}┌─────────────────────────────────────────────────────────────────────────────┐${RESET}"
    echo -e "${BOLD}${WHITE}│                             AVAILABLE TOOLS                                 │${RESET}"
    echo -e "${BOLD}${WHITE}└─────────────────────────────────────────────────────────────────────────────┘${RESET}"
    echo -e "${BOLD}${WHITE} LEGEND ${RESET}"
    echo -e "  ${GREEN}● Green Number${RESET} = Tool selected for installation/update"
    echo -e "  ${Lavender}● Lavender Number${RESET}   = Tool not selected"
    # echo -e "  ${GREEN}[INSTALLED]${RESET}     = Tool is already installed (will update to latest)"
    # echo -e "  ${RED}[NOT INSTALLED]${RESET}  = Tool needs installation"
    # echo -e "  ${GREEN}▶${RESET}              = Selected indicator"
    echo ""
    
    # Show tools
    for i in {1..17}; do
        tool="${TOOLS[$i]}"
        
        # Check installation status
        if tool_installed "$tool"; then
            status="${GREEN}[INSTALLED]${RESET}"
        else
            status="${RED}[NOT INSTALLED]${RESET}"
        fi
        
        # Check if in queue
        in_queue=false
        for queued in "${INSTALL_QUEUE[@]}"; do
            if [ "$queued" = "$tool" ]; then
                in_queue=true
                break
            fi
        done
        
        # Format the line with proper spacing
        if [ "$in_queue" = true ]; then
            printf "  ${GREEN}%2d${RESET}. ${GREEN}▶${RESET} %-55s %b\n" "$i" "${TOOL_DISPLAY[$tool]}" "$status"
        else
            printf "  ${Lavender}%2d${RESET}.   %-55s %b\n" "$i" "${TOOL_DISPLAY[$tool]}" "$status"
        fi
    done

    # Show queue count
    if [ ${#INSTALL_QUEUE[@]} -gt 0 ]; then
        echo -e "  ${GREEN}📦 Queue: ${#INSTALL_QUEUE[@]} tool(s) selected for installation/update${RESET}"
    fi
    
    echo -e "${BOLD}${WHITE}════════════════════════════════════════════════════════════════════════════════${RESET}"
    echo -e "${BOLD}${WHITE} CONTROLS ${RESET}"
    echo -e "  ${GREEN}[1-17]${RESET}  →  Select/Deselect tool for installation/update"
    echo -e "  ${GREEN}[0]${RESET}     →  Execute installation queue"
    echo -e "  ${GREEN}[C]${RESET}     →  Clear all selections"
    echo -e "  ${GREEN}[R]${RESET}     →  Refresh screen"
    echo -e "  ${RED}[Q]${RESET}     →  Quit"
    echo -e "${BOLD}${WHITE}════════════════════════════════════════════════════════════════════════════════${RESET}"
}

#===============================================================================
#  QUEUE MANAGEMENT
#===============================================================================

toggle_queue() {
    local num="$1"
    local tool="${TOOLS[$num]}"
    local new_queue=()
    local found=false
    
    # Check if tool is already in queue
    for queued in "${INSTALL_QUEUE[@]}"; do
        if [ "$queued" = "$tool" ]; then
            found=true
        else
            new_queue+=("$queued")
        fi
    done
    
    if [ "$found" = true ]; then
        INSTALL_QUEUE=("${new_queue[@]}")
    else
        INSTALL_QUEUE+=("$tool")
    fi
}

clear_queue() {
    INSTALL_QUEUE=()
}

execute_queue() {
    if [ ${#INSTALL_QUEUE[@]} -eq 0 ]; then
        echo -e "${YELLOW}⚠ Queue is empty. Select tools first.${RESET}"
        sleep 2
        return
    fi
    
    clear_screen
    show_banner
    echo -e "${BOLD}${CYAN}  ⚡ EXECUTING INSTALLATION QUEUE${RESET}\n"
    echo -e "  Tools to install/update: ${#INSTALL_QUEUE[@]}\n"
    echo -e "${BOLD}${WHITE}════════════════════════════════════════════════════════════════════════════════${RESET}\n"
    
    for tool in "${INSTALL_QUEUE[@]}"; do
        echo -e "\n${BOLD}─── Processing ${TOOL_DISPLAY[$tool]} ───${RESET}\n"
        "install_$tool"
        echo ""
        sleep 1
    done
    
    echo -e "${BOLD}${WHITE}════════════════════════════════════════════════════════════════════════════════${RESET}"
    echo -e "\n${GREEN}✓ All operations completed!${RESET}"
    
    INSTALL_QUEUE=()
    echo -e "\n${DIM}Press Enter to continue...${RESET}"
    read -r
}

#===============================================================================
#  MAIN
#===============================================================================

interactive_mode() {
    # Check and install prerequisites if needed
    if ! command -v figlet >/dev/null 2>&1; then
        echo -e "${YELLOW}⚠ figlet not found. Installing for better visuals...${RESET}"
        pkg_update && pkg_install figlet 2>/dev/null
    fi
    if ! command -v lolcat >/dev/null 2>&1; then
        echo -e "${YELLOW}⚠ lolcat not found. Installing for better visuals...${RESET}"
        pkg_install lolcat 2>/dev/null
    fi
    
    while true; do
        show_menu
        echo -n -e "${BOLD}${CYAN}  Select option: ${RESET}"
        read -r choice
        
        case "$choice" in
            0)
                execute_queue
                ;;
            [cC])
                clear_queue
                ;;
            [rR])
                continue
                ;;
            [qQ])
                clear_screen
                echo -e "\n${GREEN}👋 Thank you for using $APP_NAME by $APP_AUTHOR!${RESET}"
                exit 0
                ;;
            [1-9]|1[0-7])
                toggle_queue "$choice"
                ;;
            *)
                if [ -n "$choice" ]; then
                    echo -e "${RED}✗ Invalid option${RESET}"
                    sleep 1
                fi
                ;;
        esac
    done
}

# Check if running with --install flag
if [ "${1:-}" = "--install" ]; then
    if [ -z "${2:-}" ]; then
        echo "Usage: $SCRIPT_NAME --install <toolname>"
        echo "Available tools: base_packages, git, terraform, aws_cli, docker, docker_compose, lazydocker, ansible, snyk, trivy, gcp, kubernetes, helm, minikube, nmap, python, azure_cli"
        exit 1
    fi
    
    tool_to_install="$2"
    if declare -f "install_$tool_to_install" >/dev/null; then
        clear_screen
        if command -v figlet >/dev/null 2>&1; then
            figlet -f slant $APP_NAME 2>/dev/null
        fi
        "install_$tool_to_install"
    else
        echo "Unknown tool: $tool_to_install"
        exit 1
    fi
elif [ "${1:-}" = "--list" ]; then
    clear_screen
    if command -v figlet >/dev/null 2>&1; then
        figlet -f slant $APP_NAME 2>/dev/null
    fi
    echo -e "\n${BOLD}Available Tools:${RESET}\n"
    for i in {1..17}; do
        tool="${TOOLS[$i]}"
        echo "  $tool - ${TOOL_DISPLAY[$tool]}"
    done
elif [ "${1:-}" = "--status" ]; then
    clear_screen
    if command -v figlet >/dev/null 2>&1; then
        figlet -f slant $APP_NAME 2>/dev/null
    fi
    echo -e "\n${BOLD}Installation Status:${RESET}\n"
    for i in {1..17}; do
        tool="${TOOLS[$i]}"
        if tool_installed "$tool"; then
            echo -e "  ${GREEN}✓${RESET} $tool - ${TOOL_DISPLAY[$tool]}"
        else
            echo -e "  ${RED}✗${RESET} $tool - ${TOOL_DISPLAY[$tool]}"
        fi
    done
elif [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    if command -v figlet >/dev/null 2>&1; then
        figlet -f slant $APP_NAME 2>/dev/null
    fi
    cat << EOF

$APP_NAME v$SCRIPT_VERSION - DevSecOps Bootstrap Platform

USAGE:
    $SCRIPT_NAME                    Interactive mode with queue system
    $SCRIPT_NAME --install <tool>   Install specific tool directly
    $SCRIPT_NAME --list             List all available tools
    $SCRIPT_NAME --status           Show installation status
    $SCRIPT_NAME --help, -h         Show this help message

INTERACTIVE MODE CONTROLS:
    [1-17]  →  Select/Deselect tool for installation/update
    [0]     →  Execute installation queue
    [C]     →  Clear all selections
    [R]     →  Refresh screen
    [Q]     →  Quit

AVAILABLE TOOLS:
EOF
    for i in {1..17}; do
        tool="${TOOLS[$i]}"
        echo "    $tool - ${TOOL_DISPLAY[$tool]}"
    done
else
    interactive_mode
fi